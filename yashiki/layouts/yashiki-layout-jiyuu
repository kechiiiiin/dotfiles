#!/usr/bin/python3
# jiyuu: 何も並べない（フリーのタグ用）。ウィンドウは置いた場所のまま
import json, sys
while True:
    line = sys.stdin.readline()
    if not line:
        break
    try:
        msg = json.loads(line)
    except ValueError:
        continue
    kind = msg.get("type")
    if kind == "layout":
        res = {"type": "layout", "windows": []}
    elif kind == "command":
        res = {"type": "ok"}
    else:
        res = {"type": "error", "message": "unknown message"}
    sys.stdout.write(json.dumps(res) + "\n")
    sys.stdout.flush()
