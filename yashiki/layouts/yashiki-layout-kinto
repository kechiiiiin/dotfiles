#!/usr/bin/python3
# kinto: 表示中のウィンドウを横に均等割りする（2枚なら 1/2・1/2）
# yashiki 0.11.4 の形式: {"type":"layout",...} / {"type":"command","cmd":..,"args":[..]}
import json, sys

gap = 10
while True:
    line = sys.stdin.readline()
    if not line:
        break
    try:
        msg = json.loads(line)
    except ValueError:
        continue
    kind = msg.get("type")
    if kind == "layout":
        ids, w, h = msg["windows"], msg["width"], msg["height"]
        n = len(ids)
        out = []
        if n:
            cw = (w - gap * (n - 1)) // n
            for i, wid in enumerate(ids):
                out.append({"id": wid, "x": i * (cw + gap), "y": 0, "width": cw, "height": h})
        res = {"type": "layout", "windows": out}
    elif kind == "command":
        if msg.get("cmd") == "set-inner-gap" and msg.get("args"):
            gap = int(msg["args"][0])
            res = {"type": "needs_retile"}
        else:
            res = {"type": "ok"}
    else:
        res = {"type": "error", "message": "unknown message"}
    sys.stdout.write(json.dumps(res) + "\n")
    sys.stdout.flush()
