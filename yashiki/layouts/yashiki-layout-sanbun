#!/usr/bin/python3
# sanbun: Obsidian は右 1/3、それ以外は左 2/3（左が複数なら縦に積む）
# dokusho の名前で呼ばれたら読書用（左 1/2、右に Kindle・Obsidian の順で上から）
# 同じ Obsidian がタグ1（Claude）とタグ3（DaVinci）にいても、並び順に関係なく右へ置くため
# アプリ名は同じフォルダの winowner（CGWindowList）で引く。yashiki list-windows は呼ぶと固まる
# 引けなければ渡された順のまま最後を右へ
import json, sys, subprocess, os
gap = 10
ratio = 0.667
RIGHT_APPS = ("Obsidian",)
# dokusho（このファイルへのリンク名）: 左 1/2、右は Kindle 上・Obsidian 下
# yonbun（同じくリンク名）: 左 3/4、Obsidian 右 1/4（DaVinci のタグ）
if os.path.basename(__file__).endswith("yonbun"):
    ratio = 0.75
if os.path.basename(__file__).endswith("dokusho"):
    ratio = 0.5
    RIGHT_APPS = ("Kindle", "Obsidian")
WINOWNER = os.path.join(os.path.dirname(os.path.abspath(__file__)), "winowner")

_names = {}

def apps(ids):
    # 一度引いた ID は覚えておく（切り替えのたびに winowner を呼ぶと 0.15 秒ほど遅れる）
    if all(i in _names for i in ids):
        return _names
    try:
        out = subprocess.run([WINOWNER], capture_output=True, text=True, timeout=1).stdout
    except Exception:
        return _names
    for line in out.splitlines():
        a = line.split("\t", 1)
        if len(a) == 2 and a[0].isdigit():
            _names[int(a[0])] = a[1]
    return _names

def column(ids, x, w, h):
    n = len(ids)
    if not n:
        return []
    ch = (h - gap * (n - 1)) // n
    return [{"id": wid, "x": x, "y": i * (ch + gap), "width": w, "height": ch} for i, wid in enumerate(ids)]

while True:
    line = sys.stdin.readline()
    if not line:
        break
    try:
        msg = json.loads(line)
    except ValueError:
        continue
    kind = msg.get("type")
    if kind == "layout":
        ids, w, h = msg["windows"], msg["width"], msg["height"]
        names = apps(ids) if len(ids) > 1 else {}
        right = sorted([i for i in ids if names.get(i) in RIGHT_APPS], key=lambda i: RIGHT_APPS.index(names[i]))
        left = [i for i in ids if i not in right]
        if len(ids) > 1 and not all(i in names for i in ids):
            left, right = ids[:-1], ids[-1:]
        if left and right:
            lw = int((w - gap) * ratio)
            out = column(left, 0, lw, h) + column(right, lw + gap, w - lw - gap, h)
        else:
            out = column(ids, 0, w, h)
        res = {"type": "layout", "windows": out}
    elif kind == "command":
        cmd, args = msg.get("cmd"), msg.get("args") or []
        if cmd == "set-inner-gap" and args:
            gap = int(args[0]); res = {"type": "needs_retile"}
        elif cmd == "set-main-ratio" and args:
            ratio = float(args[0]); res = {"type": "needs_retile"}
        else:
            res = {"type": "ok"}
    else:
        res = {"type": "error", "message": "unknown message"}
    sys.stdout.write(json.dumps(res) + "\n")
    sys.stdout.flush()
