#!/bin/sh
# 2026-10-31 ヘスティア書き直し。正本は ~/dotfiles/yashiki/（直したら setup.sh で配り直す）

# 画面は名前で探す（PC が変わっても番号に頼らない）
# MAC = 内蔵ディスプレイ、DELL = それ以外の外部モニタ。外部モニタが無いときは DELL のタグも内蔵に出す
# 起動後にモニタをつないだときは yashiki を再起動する
OUTPUTS=$(yashiki list-outputs)
MAC=$(printf '%s\n' "$OUTPUTS" | sed -n 's/^\([0-9][0-9]*\): Built-in.*/\1/p' | head -1)
DELL=$(printf '%s\n' "$OUTPUTS" | grep -v 'Built-in' | sed -n 's/^\([0-9][0-9]*\): .*/\1/p' | head -1)
[ -n "$MAC" ] || MAC=$(printf '%s\n' "$OUTPUTS" | sed -n 's/^\([0-9][0-9]*\): .*/\1/p' | head -1)
[ -n "$DELL" ] || DELL="$MAC"

# Layout
yashiki layout-set-default tatami
yashiki set-outer-gap 10
yashiki layout-cmd --layout tatami set-main-ratio 0.667
yashiki layout-cmd --layout tatami set-inner-gap 10
# 自作レイアウト（~/.config/yashiki/layouts）: kinto=横に均等割り／sanbun=Obsidian 右 1/3（yonbun=右 1/4・dokusho=読書）／jiyuu=並べない
# どのタグにどれを使うかは PC ごとのファイル（hosts/）で決める
yashiki add-exec-path "$HOME/.config/yashiki/layouts"

# Cursor warp (mouse follows focus)
yashiki set-cursor-warp on-focus-change

# Auto-raise (focus follows mouse) - with 100ms delay to avoid accidental focus changes
yashiki set-auto-raise enabled --delay 100

# Tags: 1-4 は常に DELL、5-9 は常に Mac（9=その他）
for i in 1 2 3 4; do
  yashiki bind "alt-$i" tag-view --output "$DELL" "$((1<<(i-1)))"
done
for i in 5 6 7 8; do
  yashiki bind "alt-$i" tag-view --output "$MAC" "$((1<<(i-1)))"
done
for i in 1 2 3 4 5 6 7 8 9; do
  yashiki bind "alt-shift-$i" window-move-to-tag "$((1<<(i-1)))"
  yashiki bind "alt-ctrl-$i" window-toggle-tag "$((1<<(i-1)))"
done
# Option+9 は Mac の「その他」: タグ9と、起動時に行き場の無かった浮きウィンドウ（Mac のタグ1）をまとめて出す
yashiki bind alt-9 tag-view --output "$MAC" 257
yashiki bind alt-0 tag-view-last

# Window focus
yashiki bind alt-j window-focus next
yashiki bind alt-k window-focus prev
yashiki bind alt-h layout-cmd dec-main-ratio
yashiki bind alt-l layout-cmd inc-main-ratio
yashiki bind alt-comma layout-cmd inc-main-count
yashiki bind alt-period layout-cmd dec-main-count

# Window management
yashiki bind alt-f window-toggle-fullscreen
yashiki bind alt-shift-f window-toggle-float
yashiki bind alt-shift-c window-close
yashiki bind alt-z layout-cmd zoom
yashiki bind alt-n window-swap next
yashiki bind alt-m window-swap prev

# Multi-monitor
yashiki bind alt-o output-focus next
yashiki bind alt-shift-o output-send next
yashiki bind alt-shift-p output-send prev

# Layout
yashiki bind alt-r retile

# Common float rules
yashiki rule-add --app-name Finder float
yashiki rule-add --app-name "System Settings" float
yashiki rule-add --app-name "システム設定" float
yashiki rule-add --app-name "写真" float
yashiki rule-add --subrole Dialog float

# Conductor キーボードから送る Cmd+Ctrl+Option+Shift の組み合わせ（2026-10-31）
# W か O の長押しで Layer 10（window）。右手の上段 Y U I O = DELL タグ1〜4、中段 H J K L - = Mac タグ5〜9、左手 = 操作
# J と T は別の用途で使用中なので使わない
H="cmd-ctrl-alt-shift"
for i in 1 2 3 4; do
  yashiki bind "$H-$i" tag-view --output "$DELL" "$((1<<(i-1)))"
done
for i in 5 6 7 8; do
  yashiki bind "$H-$i" tag-view --output "$MAC" "$((1<<(i-1)))"
done
# 5番目はフリー: DELL は P（タグ10）、Mac は -（タグ9＋行き場の無い浮きウィンドウ）
yashiki bind "$H-p" tag-view --output "$DELL" 512
yashiki bind "$H-9" tag-view --output "$MAC" 257
yashiki bind "$H-q" window-close
yashiki bind "$H-w" window-focus prev
yashiki bind "$H-e" window-focus next
yashiki bind "$H-r" retile
yashiki bind "$H-0" tag-view-last
yashiki bind "$H-a" window-focus left
yashiki bind "$H-s" window-focus down
yashiki bind "$H-d" window-focus up
yashiki bind "$H-f" window-toggle-fullscreen
yashiki bind "$H-g" output-focus next
yashiki bind "$H-z" window-swap next
yashiki bind "$H-c" window-toggle-float
yashiki bind "$H-v" output-send next

# PC ごとの配置（タグとアプリの対応・タグごとの並べ方）
# ~/.config/yashiki/hosts/<この Mac の LocalHostName>.sh を読む。無ければ配置なし（全部 tatami で並ぶ）
HOST=$(scutil --get LocalHostName 2>/dev/null || hostname -s)
if [ -f "$HOME/.config/yashiki/hosts/$HOST.sh" ]; then
  . "$HOME/.config/yashiki/hosts/$HOST.sh"
fi
